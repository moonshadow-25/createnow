{
  "image": {
    "label": "资产图片",
    "category": "生成模板",
    "presets": {
      "default_ai": {
        "name": "默认AI",
        "description": "对话AI生成image_prompt时的格式规范（角色16:9三视图、道具三视图、场景2x2四宫格）",
        "content_file": "image/default_ai.md"
      }
    }
  },
  "video": {
    "label": "视频",
    "category": "生成模板",
    "presets": {
      "default_ai": {
        "name": "默认AI",
