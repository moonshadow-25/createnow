+def validate_description_anchor(script: str, anchor: Dict[str, Any]) -> Dict:
+    if not isinstance(anchor, dict):
+        return {"ok": False, "error": "description_anchor 必须是对象，包含 start_anchor_text/end_anchor_text", "code": "ANCHOR_PAYLOAD_INVALID"}
+
+    start_anchor = str(anchor.get("start_anchor_text") or "").strip()
+    end_anchor = str(anchor.get("end_anchor_text") or "").strip()
+    if not start_anchor:
+        return {"ok": False, "error": "description_anchor.start_anchor_text 不能为空", "code": "START_ANCHOR_EMPTY"}
+    if not end_anchor:
+        return {"ok": False, "error": "description_anchor.end_anchor_text 不能为空", "code": "END_ANCHOR_EMPTY"}
+
+    text = str(script or "")
+
+    start_positions = []
+    pos = text.find(start_anchor)
+    while pos != -1:
+        start_positions.append(pos)
+        pos = text.find(start_anchor, pos + 1)
+
+    end_positions = []
+    pos = text.find(end_anchor)
+    while pos != -1:
+        end_positions.append(pos)
+        pos = text.find(end_anchor, pos + 1)
+
+    if len(start_positions) == 0:
+        return {"ok": False, "error": "start_anchor_text 未在剧本中找到，请扩展锚点文本", "code": "START_ANCHOR_NOT_FOUND", "start_match_count": 0}
+    if len(end_positions) == 0:
+        return {"ok": False, "error": "end_anchor_text 未在剧本中找到，请扩展锚点文本", "code": "END_ANCHOR_NOT_FOUND", "end_match_count": 0}
+    if len(start_positions) != 1:
+        return {"ok": False, "error": "start_anchor_text 匹配不唯一，请扩展锚点文本", "code": "START_ANCHOR_NOT_UNIQUE", "start_match_count": len(start_positions)}
+    if len(end_positions) != 1:
+        return {"ok": False, "error": "end_anchor_text 匹配不唯一，请扩展锚点文本", "code": "END_ANCHOR_NOT_UNIQUE", "end_match_count": len(end_positions)}
+
+    start_offset = start_positions[0]
+    end_offset = end_positions[0] + len(end_anchor)
+    if end_offset <= start_offset:
+        return {"ok": False, "error": "end_anchor 在 start_anchor 之前，请调整锚点", "code": "ANCHOR_ORDER_INVALID"}
+
+    return {
+        "ok": True,
+        "start_offset": start_offset,
+        "end_offset": end_offset,
+        "start_anchor_text": start_anchor,
+        "end_anchor_text": end_anchor,
+    }
+
+
+def build_description_from_anchor(script: str, anchor: Dict[str, Any], label: str = "") -> Dict:
+    checked = validate_description_anchor(script, anchor)
+    if not checked.get("ok"):
+        return checked
+
+    start = checked["start_offset"]
+    end = checked["end_offset"]
+    body = str(script or "")[start:end].strip()
+    if not body:
+        return {"ok": False, "error": "anchor 对应原文为空，请扩展锚点文本", "code": "SLICE_EMPTY"}
+
+    return {
+        "ok": True,
+        "description": body,
+        "start_offset": start,
+        "end_offset": end,
+        "start_anchor_text": checked.get("start_anchor_text"),
+        "end_anchor_text": checked.get("end_anchor_text"),
+    }
+
+
